FROM python:3.12-slim-bookworm
WORKDIR /app
COPY client_python/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY proto /proto
RUN python -m grpc_tools.protoc -I/proto --python_out=/app --grpc_python_out=/app /proto/file_processor.proto
COPY client_python /app
ENTRYPOINT ["python", "/app/client.py"]
